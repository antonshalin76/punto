#!/bin/sh
set -e

PKG_VERSION="@PUNTO_VERSION@"
: "$PKG_VERSION"

update_user_tray() {
    case "${1:-}" in
        reload|restart|stop) punto_tray_action=$1 ;;
        *) return 0 ;;
    esac
    # init-system-helpers 1.66 accumulates the restart list across user
    # managers. Use systemd's per-manager atomic try-restart instead: an
    # inactive static unit stays inactive. One hard deadline covers policy,
    # reload, discovery and actions so no user bus can stall dpkg configuration.
    # shellcheck disable=SC2016  # The inner shell expands these variables.
    timeout --signal=KILL 3s /bin/sh -c '
        punto_tray_action=$1
        punto_restart_allowed=true
        if [ "$punto_tray_action" = restart ] &&
           [ -x /usr/sbin/policy-rc.d ]; then
            if /usr/sbin/policy-rc.d punto-tray.service restart \
                >/dev/null 2>&1; then
                punto_policy_rc=0
            else
                punto_policy_rc=$?
            fi
            case "$punto_policy_rc" in
                0|104) ;;
                101) punto_restart_allowed=false ;;
                *)
                    echo "punto-switcher: policy-rc.d returned $punto_policy_rc; continuing bounded tray refresh" >&2
                    ;;
            esac
        fi

        if [ "$punto_tray_action" = stop ]; then
            deb-systemd-invoke --user stop punto-tray.service \
                >/dev/null 2>&1 || true
        fi
        deb-systemd-invoke --user daemon-reload >/dev/null 2>&1 || true
        if [ "$punto_tray_action" != restart ] ||
           [ "$punto_restart_allowed" != true ]; then
            exit 0
        fi

        systemctl --system --no-legend --plain --state=active \
            --type=service list-units '\''user@*.service'\'' |
        while IFS=" " read -r punto_manager _; do
            case "$punto_manager" in
                user@*.service) ;;
                *) continue ;;
            esac
            punto_user=${punto_manager#user@}
            punto_user=${punto_user%.service}
            case "$punto_user" in
                ""|*[!0-9]*) continue ;;
            esac
            case "$punto_user" in
                0|[1-9]*) ;;
                *) continue ;;
            esac
            systemctl --quiet --no-block --user \
                --machine="${punto_user}@" try-restart -- \
                punto-tray.service >/dev/null 2>&1 || true
        done
    ' punto-tray-lifecycle "$punto_tray_action" >/dev/null || true
}

case "${1:-}" in
    configure)
        if ! getent group punto >/dev/null 2>&1; then
            if ! command -v groupadd >/dev/null 2>&1; then
                echo "punto-switcher: groupadd is unavailable" >&2
                exit 1
            fi
            groupadd --system punto
        fi
        punto_group=$(getent group punto) || {
            echo "punto-switcher: cannot resolve punto group" >&2
            exit 1
        }
        punto_gid=$(printf '%s\n' "$punto_group" | cut -d: -f3)
        case "$punto_gid" in
            ''|*[!0-9]*)
                echo "punto-switcher: cannot resolve numeric punto group" >&2
                exit 1
                ;;
        esac

        if [ ! -d /etc/punto ] || [ -L /etc/punto ]; then
            echo "punto-switcher: /etc/punto is not a trusted directory" >&2
            exit 1
        fi
        punto_dir_state=$(stat -c '%u:%g:%a' /etc/punto 2>/dev/null || true)
        punto_dir_owner=${punto_dir_state%%:*}
        punto_dir_remainder=${punto_dir_state#*:}
        punto_dir_group=${punto_dir_remainder%%:*}
        punto_dir_mode=${punto_dir_remainder#*:}
        case "$punto_dir_mode" in
            ''|*[!0-7]*)
                echo "punto-switcher: /etc/punto has invalid metadata" >&2
                exit 1
                ;;
        esac
        if [ "$punto_dir_owner" != 0 ] || [ "$punto_dir_group" != 0 ] ||
           [ $((0$punto_dir_mode & 0022)) -ne 0 ]; then
            echo "punto-switcher: /etc/punto is not root-owned and protected" >&2
            exit 1
        fi
        runtime_gid=/etc/punto/runtime-gid
        runtime_gid_current=false
        if [ -f "$runtime_gid" ] && [ ! -L "$runtime_gid" ]; then
            runtime_gid_state=$(stat -c '%u:%g:%a:%h:%s' "$runtime_gid" 2>/dev/null || true)
            runtime_gid_size=$((${#punto_gid} + 1))
            if [ "$runtime_gid_state" = "0:0:644:1:$runtime_gid_size" ]; then
                runtime_gid_value=$(cat "$runtime_gid" 2>/dev/null || true)
                if [ "$runtime_gid_value" = "$punto_gid" ]; then
                    runtime_gid_current=true
                fi
            fi
        fi
        if [ "$runtime_gid_current" != true ]; then
            umask 077
            runtime_gid_tmp=$(mktemp /etc/punto/.runtime-gid.XXXXXX) || exit 1
            trap 'rm -f -- "${runtime_gid_tmp:-}"' 0 HUP INT TERM
            printf '%s\n' "$punto_gid" >"$runtime_gid_tmp"
            chown root:root "$runtime_gid_tmp"
            chmod 0644 "$runtime_gid_tmp"
            if ! mv -fT -- "$runtime_gid_tmp" "$runtime_gid"; then
                echo "punto-switcher: cannot publish runtime group id" >&2
                exit 1
            fi
            runtime_gid_tmp=
            trap - 0 HUP INT TERM
        fi

        # Static user units are started by XDG autostart, not globally from a
        # root maintainer script. A daemon-only replacement must stop an
        # earlier full-package tray.
        if [ ! -x /usr/bin/punto-tray ]; then
            update_user_tray stop
        elif [ -n "${2:-}" ]; then
            update_user_tray restart
        else
            update_user_tray reload
        fi

        ;;
esac

exit 0
