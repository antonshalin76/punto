#!/bin/sh
set -e

PKG_VERSION="@PUNTO_VERSION@"
: "$PKG_VERSION"

case "${1:-}" in
    configure)
        if ! getent group punto >/dev/null 2>&1; then
            if ! command -v groupadd >/dev/null 2>&1; then
                echo "punto-switcher: groupadd is unavailable" >&2
                exit 1
            fi
            groupadd --system punto
        fi
        punto_group=$(getent group punto) || {
            echo "punto-switcher: cannot resolve punto group" >&2
            exit 1
        }
        punto_gid=$(printf '%s\n' "$punto_group" | cut -d: -f3)
        case "$punto_gid" in
            ''|*[!0-9]*)
                echo "punto-switcher: cannot resolve numeric punto group" >&2
                exit 1
                ;;
        esac

        # Admission precedes all permission changes. Maintscripts also run in
        # chroots without /proc, so secure parents before revalidating children.
        for punto_ancestor in / /etc /usr /usr/share; do
            punto_access=$(LC_ALL=C /usr/bin/ls -ld -- "$punto_ancestor") || exit 1
            punto_access=${punto_access%% *}
            if [ ! -d "$punto_ancestor" ] || [ -L "$punto_ancestor" ] ||
               [ "$(stat -c '%u:%g:%a' "$punto_ancestor")" != 0:0:755 ] ||
               [ "${#punto_access}" != 10 ]; then
                echo "punto-switcher: directory ancestor is not protected" >&2
                exit 1
            fi
        done
        punto_directories=
        for punto_target in /etc/punto /usr/share/punto-switcher /usr/share/punto-switcher/sounds; do
            if [ ! -d "$punto_target" ] || [ -L "$punto_target" ]; then
                echo "punto-switcher: package directory is not trusted" >&2
                exit 1
            fi
            punto_access=$(LC_ALL=C /usr/bin/ls -ld -- "$punto_target") || exit 1
            punto_access=${punto_access%% *}
            punto_dir_state=$(stat -c '%d:%i:%u:%g:%a' "$punto_target") || exit 1
            if [ "${#punto_access}" != 10 ]; then
                echo "punto-switcher: alternate directory access is not admitted" >&2
                exit 1
            fi
            case "$punto_dir_state" in
                *:0:0:755) ;;
                *:0:0:775)
                    if [ "$punto_target" = /etc/punto ] && [ "${2:-}" != 2.8.5 ]; then
                        echo "punto-switcher: unrecognized /etc/punto migration" >&2
                        exit 1
                    fi
                    ;;
                *) echo "punto-switcher: package directory metadata is not admitted" >&2; exit 1 ;;
            esac
            punto_directories="${punto_directories}${punto_directories:+
}$punto_target|$punto_dir_state"
        done
        printf '%s\n' "$punto_directories" | while IFS='|' read -r punto_target punto_dir_state; do
            punto_access=$(LC_ALL=C /usr/bin/ls -ld -- "$punto_target") || exit 1
            punto_access=${punto_access%% *}
            if [ -L "$punto_target" ] || [ "${#punto_access}" != 10 ] ||
               [ "$(stat -c '%d:%i:%u:%g:%a' "$punto_target")" != "$punto_dir_state" ]; then
                echo "punto-switcher: directory changed before permission normalization" >&2
                exit 1
            fi
            if [ "${punto_dir_state##*:}" = 775 ]; then
                chmod 0755 "$punto_target" || exit 1
            fi
            if [ -L "$punto_target" ] ||
               [ "$(stat -c '%d:%i:%u:%g:%a' "$punto_target")" != "${punto_dir_state%:*}:755" ]; then
                echo "punto-switcher: cannot secure package directory" >&2
                exit 1
            fi
        done

        # Older releases created learned exclusions with the default 0644
        # mode. Only secure this exact trusted inode; never rewrite its words
        # or follow links. The validated parent cannot be replaced by users.
        punto_exclusions=/etc/punto/undo_exclusions.txt
        if [ -e "$punto_exclusions" ] || [ -L "$punto_exclusions" ]; then
            punto_exclusions_state=unsafe
            if [ -f "$punto_exclusions" ] && [ ! -L "$punto_exclusions" ]; then
                punto_exclusions_state=$(stat -c '%u:%g:%a:%h' "$punto_exclusions" 2>/dev/null || true)
            fi
            case "$punto_exclusions_state" in
                0:0:644:1)
                    if ! chmod 0600 "$punto_exclusions" ||
                       [ "$(stat -c '%u:%g:%a:%h' "$punto_exclusions" 2>/dev/null || true)" != 0:0:600:1 ]; then
                        echo "punto-switcher: cannot secure legacy exclusions" >&2
                        exit 1
                    fi
                    ;;
                0:0:600:1) ;;
                *) echo "punto-switcher: unsafe legacy exclusions left unchanged" >&2 ;;
            esac
        fi
        runtime_gid=/etc/punto/runtime-gid
        runtime_gid_current=false
        if [ -f "$runtime_gid" ] && [ ! -L "$runtime_gid" ]; then
            runtime_gid_state=$(stat -c '%u:%g:%a:%h:%s' "$runtime_gid" 2>/dev/null || true)
            runtime_gid_size=$((${#punto_gid} + 1))
            if [ "$runtime_gid_state" = "0:0:644:1:$runtime_gid_size" ]; then
                runtime_gid_value=$(cat "$runtime_gid" 2>/dev/null || true)
                if [ "$runtime_gid_value" = "$punto_gid" ]; then
                    runtime_gid_current=true
                fi
            fi
        fi
        if [ "$runtime_gid_current" != true ]; then
            umask 077
            runtime_gid_tmp=$(mktemp /etc/punto/.runtime-gid.XXXXXX) || exit 1
            trap 'rm -f -- "${runtime_gid_tmp:-}"' 0 HUP INT TERM
            printf '%s\n' "$punto_gid" >"$runtime_gid_tmp"
            chown root:root "$runtime_gid_tmp"
            chmod 0644 "$runtime_gid_tmp"
            if ! mv -fT -- "$runtime_gid_tmp" "$runtime_gid"; then
                echo "punto-switcher: cannot publish runtime group id" >&2
                exit 1
            fi
            runtime_gid_tmp=
            trap - 0 HUP INT TERM
        fi

        # Static user units are discovered at the next graphical login. Package
        # configuration must not contact or mutate any active user manager.

        ;;
esac

exit 0
